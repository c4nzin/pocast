{
  "name": "@pocast/auth-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/auth-service/dist/package.json",
          "{workspaceRoot}/apps/auth-service/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/auth-service/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/auth-service/dist/patches",
          "{workspaceRoot}/apps/auth-service/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/auth-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@pocast/auth-service:build",
          "runBuildTargetDependencies": false,
          "port": 9231
        },
        "configurations": {
          "development": {
            "buildTarget": "@pocast/auth-service:build:development"
          },
          "production": {
            "buildTarget": "@pocast/auth-service:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        },
        "dependsOn": [
          "^build",
          "prisma-generate"
        ]
      },
      "prisma-generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma.config.ts"
        ],
        "outputs": [
          "{projectRoot}/src/generated/prisma"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma generate"
        }
      },
      "prisma-migrate": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma migrate dev"
        }
      },
      "prisma-deploy": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma migrate deploy"
        }
      },
      "prisma-deploy-test": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma migrate deploy",
          "env": {
            "PRISMA_TARGET": "test"
          }
        }
      },
      "prisma-studio": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "cwd": "{projectRoot}",
          "command": "prisma studio"
        }
      },
      "build": {
        "dependsOn": [
          "^build",
          "prisma-generate"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^typecheck",
          "prisma-generate"
        ]
      },
      "lint": {
        "dependsOn": [
          "prisma-generate"
        ]
      }
    },
    "tags": [
      "type:app",
      "scope:auth"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/platform-express": "^11.0.0",
    "@node-rs/argon2": "^2.2.2",
    "@pocast/contracts": "workspace:*",
    "@pocast/microservice-kit": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0"
  }
}
